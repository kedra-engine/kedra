{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnerBucketAdministration",
      "Effect": "Allow",
      "Principal": { "CanonicalUser": "ajeucu99vvdad25qequ7" },
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::kedra.tech", "arn:aws:s3:::kedra.tech/*"]
    },
    {
      "Sid": "PublicObjectRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::kedra.tech/*"
    },
    {
      "Sid": "PublisherBucketRead",
      "Effect": "Allow",
      "Principal": { "CanonicalUser": "ajetie3i301pghia7bkk" },
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::kedra.tech"
    },
    {
      "Sid": "PublisherObjects",
      "Effect": "Allow",
      "Principal": { "CanonicalUser": "ajetie3i301pghia7bkk" },
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::kedra.tech/*"
    }
  ]
}
