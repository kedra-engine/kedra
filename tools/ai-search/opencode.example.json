{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "rust-docs": {
        "type": "local",
        "command": ["docs-mcp"],
        "cwd": ".",
        "timeout": {
          "startup": 30000,
          "execution": 180000
        }
      },
      "kedra-search": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "--ignore-scripts",
          "--package=open-codebase-index@0.37.2",
          "--",
          "open-codebase-index-mcp",
          "--project",
          ".",
          "--host",
          "jcode"
        ],
        "cwd": ".",
        "timeout": {
          "startup": 120000,
          "execution": 900000
        }
      }
    }
  }
}
